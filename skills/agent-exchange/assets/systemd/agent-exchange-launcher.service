[Unit]
Description=Agent Exchange request launcher
Wants=herdr-agent-exchange.service
After=herdr-agent-exchange.service

[Service]
Type=simple
EnvironmentFile=@ENVIRONMENT_FILE@
ExecStart=/bin/sh -c 'exec "$${AGENT_EXCHANGE_SKILL_DIR:?AGENT_EXCHANGE_SKILL_DIR must be set}/scripts/launcher.sh"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
