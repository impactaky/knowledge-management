# Knowledge Store Selection (required)
# Path to the store's root CATALOG.md file.
FEDERATION_CATALOG=/path/to/store/CATALOG.md

# UI Server Bind Address and Port
UI_HOST=127.0.0.1
UI_PORT=7776
# KNOWLEDGE_UI_BASE_URL=http://127.0.0.1:7776

# Runtime Data Directory (default: <repo_root>/.data)
# Stores service logs (meilisearch.log, ollama.log) and live marimo session state.
# KNOWLEDGE_DATA_DIR=/path/to/store/.data

# Meilisearch (optional semantic/lexical index backend)
# A configured MEILI_URL alone means connect, not launch.
# MEILI_URL=http://127.0.0.1:7700
# MEILI_API_KEY=

# Local Meilisearch Process Management
# Set to 1 to have the launcher verify health or start a local Meilisearch binary.
# KNOWLEDGE_MANAGE_MEILI=0
# MEILI_BIN=/path/to/meilisearch
# MEILI_DB_PATH=/path/to/store/.data/meili_data
# MEILI_MASTER_KEY=

# Ollama (optional local embedding backend)
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
# OLLAMA_EMBED_MODEL=bge-m3

# Local Ollama Process Management
# Set to 1 to have the launcher verify health or start a local Ollama service.
# KNOWLEDGE_MANAGE_OLLAMA=0
# OLLAMA_BIN=/path/to/ollama
# OLLAMA_MODELS=/path/to/store/.data/ollama

# Embedding Model Warmup
# Set to 1 to send an initial /api/embed warmup request with keep_alive=-1.
# KNOWLEDGE_WARMUP_EMBEDDING=0
# Optional override if launcher reaches Ollama at a different URL than Meilisearch:
# OLLAMA_WARMUP_URL=http://127.0.0.1:11434/api/embed

# Feature Switches
# Set to 1 to enable startup index verification and filesystem watching (requires MEILI_URL)
# KNOWLEDGE_AUTO_INDEX=0
# Set to 1 to enable live executable notebooks (requires optional 'notebook' dependency)
# KNOWLEDGE_ENABLE_LIVE_MARIMO=0
# KNOWLEDGE_MARIMO_HOST=127.0.0.1
